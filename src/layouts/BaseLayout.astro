---
import '../styles/global.css';
import version from '../../version.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Context rails demos' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <p class="shell about">
      context-rails {version.version} ·
      <a href="https://hci-nerdz.github.io/docs/hci-nerdz/context-rails.html">Docs</a>
      ·
      <a href={`${base}`}>Hub</a>
      ·
      <a href="https://github.com/HCI-Nerdz/context-rails">GitHub</a>
    </p>
  </body>
</html>
