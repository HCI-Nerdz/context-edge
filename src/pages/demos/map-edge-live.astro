---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
---

<BaseLayout
  title="Map Edge · Live"
  description="Map Edge rails thicken with pointer proximity — constant reaction test."
>
  <main class="shell">
    <DemoHead
      variant="map"
      mode="live"
      title="Map Edge"
      lede="Click the L-edge for a wireframe directory. Streets under the activity, not tabs on the roof."
    />
    <div id="vanilla-root" transition:animate="fade"></div>
  </main>
</BaseLayout>

<script data-astro-rerun>
  import { mountVanillaRails } from '../../components/vanilla/mount';

  const root = document.getElementById('vanilla-root');
  if (root) {
    root.replaceChildren();
    mountVanillaRails({ root, initialId: 'admin' });
    const stage = root.querySelector('.cr-stage') as HTMLElement | null;
    if (stage) {
      stage.classList.add('is-live');
      stage.addEventListener('pointermove', (e: PointerEvent) => {
        const r = stage.getBoundingClientRect();
        const top = Math.max(0, 1 - (e.clientY - r.top) / 80);
        const left = Math.max(0, 1 - (e.clientX - r.left) / 80);
        const t = Math.max(top, left);
        const idle = 0.35;
        const hover = 2.75;
        const v = `${idle + (hover - idle) * t}rem`;
        stage.style.setProperty('--rail-top', v);
        stage.style.setProperty('--rail-left', v);
      });
      stage.addEventListener('pointerleave', () => {
        stage.style.removeProperty('--rail-top');
        stage.style.removeProperty('--rail-left');
      });
    }
  }
</script>
