---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import ContextRailsShell from '../../components/svelte/ContextRailsShell.svelte';
import { hrefWithBase } from '../../lib/base';
---

<BaseLayout
  title="Svelte community · Context rails"
  description="Svelte island demo — community/spaces ecosystem with softer chrome."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Hub</a></p>
    <p class="eyebrow">Demo · Svelte</p>
    <h1>Community spaces</h1>
    <p class="lede">
      Subsection and role navigation as substrate — not ephemeral header pills on the feed.
    </p>
    <VariantSwitch current="map" />
    <ContextRailsShell client:load initialId="docs" />
  </main>
</BaseLayout>
