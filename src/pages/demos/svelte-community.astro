---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import MapEdgeShell from '../../components/svelte/MapEdgeShell.svelte';
---

<BaseLayout
  title="Svelte community · Context Edge"
  description="Svelte implementation demo — community/spaces ecosystem with softer chrome."
>
  <main class="shell">
    <DemoHead
      variant="map"
      framework="svelte"
      title="Community spaces"
      lede="Subsection and role navigation as substrate — not ephemeral header pills on the feed."
    />
    <MapEdgeShell client:load initialId="docs" />
  </main>
</BaseLayout>
