---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import { hrefWithBase } from '../../lib/base';
---

<BaseLayout
  title="Path Edge · breadcrumb colors"
  description="Variant C: stacked path colors on the L-rail; hover expands both edges; labels on top only."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Hub</a></p>
    <p class="eyebrow">Demo · Variant C · Path Edge</p>
    <h1>Path Edge (breadcrumb colors)</h1>
    <p class="lede">
      The edge is a path trace: unique colors for the hops from root to here.
      Hover either edge and <em>both</em> present — same nav type. Text only on the top edge.
      Left edge: current level top-most, one mark per level, ancestors compress then unfold on
      scroll.
    </p>
    <VariantSwitch current="path" />
    <div id="path-edge-root"></div>
  </main>
</BaseLayout>

<style is:global>
  .pe-toolbar label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pe-toolbar input[type='range'] {
    width: 9rem;
  }

  .pe-stage {
    --idle: 0.42rem;
    --hover-top: 2.6rem;
    --hover-left: 3.4rem;
    --rail-top: var(--idle);
    --rail-left: var(--idle);
    position: relative;
    min-height: 28rem;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    overflow: hidden;
    background:
      radial-gradient(80% 70% at 100% 0%, rgba(161, 66, 244, 0.12), transparent 50%),
      #101418;
  }

  .pe-stage.is-expanded {
    --rail-top: var(--hover-top);
    --rail-left: var(--hover-left);
  }

  .pe-corner {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: var(--rail-left);
    height: var(--rail-top);
    padding: 0;
    border: 0;
    cursor: pointer;
    background: transparent;
    transition: width 0.22s ease, height 0.22s ease;
  }

  .pe-corner-top,
  .pe-corner-left {
    position: absolute;
    inset: 0;
  }

  /* Top rail owns the upper-right of the square; left rail owns the lower-left. */
  .pe-corner-top {
    background: var(--top-seg);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }

  .pe-corner-left {
    background: var(--left-seg);
    clip-path: polygon(0 0, 100% 100%, 0 100%);
  }

  .pe-corner::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      135deg,
      transparent calc(50% - 0.6px),
      rgba(0, 0, 0, 0.35) 50%,
      transparent calc(50% + 0.6px)
    );
  }

  .pe-corner:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
  }

  .pe-top {
    position: absolute;
    top: 0;
    left: var(--rail-left);
    right: 0;
    height: var(--rail-top);
    display: flex;
    z-index: 4;
    transition: height 0.22s ease, left 0.22s ease;
  }

  .pe-left {
    position: absolute;
    top: var(--rail-top);
    left: 0;
    bottom: 0;
    width: var(--rail-left);
    z-index: 4;
    transition: width 0.22s ease, top 0.22s ease;
    overflow: hidden;
  }

  .pe-left-scroll {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .pe-seg {
    border: 0;
    margin: 0;
    padding: 0;
    cursor: pointer;
    color: #fff;
    background: var(--seg);
    font-family: var(--font-display);
  }

  .pe-seg:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
    z-index: 1;
  }

  .pe-seg-top {
    flex: 1 1 0;
    display: grid;
    place-items: center;
    min-width: 0;
  }

  .pe-label {
    opacity: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition: opacity 0.18s ease;
  }

  .pe-stage.is-expanded .pe-label {
    opacity: 1;
  }

  .pe-seg-left {
    display: grid;
    place-items: center;
    flex: 1 1 0;
    min-height: 1.6rem;
  }

  .pe-seg-left.is-here {
    flex: 0 0 auto;
    min-height: 3.1rem;
    padding-top: 0.15rem;
  }

  .pe-seg-left.is-ancestor {
    flex: 1 1 0;
    max-height: calc((100% - var(--ceiling)) / 4);
  }

  .pe-stage.is-expanded .pe-seg-left.is-ancestor {
    max-height: none;
    min-height: 2.4rem;
  }

  .pe-mark {
    opacity: 0;
    font-size: 1.05rem;
    line-height: 1;
  }

  .pe-stage.is-expanded .pe-mark {
    opacity: 1;
  }

  .pe-content {
    margin: calc(var(--idle) + 0.85rem) 1rem 1rem calc(var(--idle) + 0.85rem);
  }
</style>

<script>
  import { mountPathEdge } from '../../components/vanilla/mountPathEdge';

  const root = document.getElementById('path-edge-root');
  if (root) mountPathEdge({ root });
</script>
