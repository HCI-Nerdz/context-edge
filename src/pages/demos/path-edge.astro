---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import '../../styles/path-edge.css';
---

<BaseLayout
  title="Path Edge"
  description="Path trace workshop: Color / Subtle on row one, Live / Live Subtle on row two."
>
  <main class="shell">
    <DemoHead
      variant="path"
      title="Path Edge"
      lede="The L-edge is a path trace. Color and Subtle on row one; Live and Live Subtle on row two."
    />
    <div id="path-edge-root"></div>
  </main>
</BaseLayout>
