---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import '../../styles/path-edge.css';
---

<BaseLayout
  title="Path Edge"
  description="Path trace workshop: Top or Side edge; Color / Subtle / Live / Live Subtle."
>
  <main class="shell">
    <DemoHead
      variant="path"
      title="Path Edge"
      lede="One edge at a time — Top (labels) or Side (marks). Color and Subtle on row one; Live and Live Subtle on row two. Each cell keeps its own hover."
    />
    <div id="path-edge-root"></div>
  </main>
</BaseLayout>
