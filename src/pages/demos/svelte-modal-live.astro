---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import ModalEdgeShell from '../../components/svelte/ModalEdgeShell.svelte';
import {
  MODAL_EDGE_DESCRIPTION_LIVE,
  MODAL_EDGE_LEDE_LIVE,
} from '../../lib/modal-edge';
import '../../styles/modal-edge.css';
---

<BaseLayout
  title="Svelte Modal Edge · Live · Context Edge"
  description={MODAL_EDGE_DESCRIPTION_LIVE}
>
  <main class="shell">
    <DemoHead
      variant="modal"
      mode="live"
      framework="svelte"
      title="Modal Edge"
      lede={MODAL_EDGE_LEDE_LIVE}
    />
    <ModalEdgeShell client:load island="Svelte" live={true} />
  </main>
</BaseLayout>
