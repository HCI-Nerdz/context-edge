---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import FrameworkSwitch from '../../components/FrameworkSwitch.astro';
import FrameworkMark from '../../components/FrameworkMark.astro';
import PathEdgeShell from '../../components/solid/PathEdgeShell';
import { hrefWithBase } from '../../lib/base';
import '../../styles/path-edge.css';
---

<BaseLayout
  title="Solid Path Edge · Context Edge"
  description="Solid island — Path Edge breadcrumb colors."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Context Edge</a></p>
    <p class="eyebrow">Demo · Solid · Variant C</p>
    <div class="page-kicker">
      <FrameworkMark id="solid" />
      <h1>Path Edge</h1>
    </div>
    <p class="lede">
      Same L-join as Map and Modal. The rails are the hops you took — unique colors, current at the corner.
    </p>
    <div class="demo-switches">
      <VariantSwitch current="path" framework="solid" />
      <FrameworkSwitch current="solid" variant="path" />
    </div>
    <PathEdgeShell client:load island="Solid" />
  </main>
</BaseLayout>
