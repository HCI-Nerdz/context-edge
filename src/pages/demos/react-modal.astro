---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import FrameworkSwitch from '../../components/FrameworkSwitch.astro';
import FrameworkMark from '../../components/FrameworkMark.astro';
import ModalEdgeShell from '../../components/react/ModalEdgeShell';
import { hrefWithBase } from '../../lib/base';
import '../../styles/modal-edge.css';
---

<BaseLayout
  title="React Modal Edge · Edge Bar"
  description="React island — Modal Edge ancestry stack."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Edge Bar</a></p>
    <p class="eyebrow">Demo · React · Variant B</p>
    <div class="page-kicker">
      <FrameworkMark id="react" />
      <h1>Modal Edge</h1>
    </div>
    <p class="lede">
      Same L-join as Map. Click slides this sheet back; ancestors stay as colored layers.
    </p>
    <div class="demo-switches">
      <VariantSwitch current="modal" framework="react" />
      <FrameworkSwitch current="react" variant="modal" />
    </div>
    <ModalEdgeShell client:load island="React" />
  </main>
</BaseLayout>
