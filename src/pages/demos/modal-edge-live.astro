---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import '../../styles/modal-edge.css';
---

<BaseLayout
  title="Modal Edge · Live"
  description="Pointer near the edges peeks the modal sheet — constant reaction test."
>
  <main class="shell">
    <DemoHead
      variant="modal"
      mode="live"
      title="Modal Edge"
      lede="The edge is this sheet. Click to slide it back; ancestor layers stay underneath."
    />
    <div id="modal-edge-root" data-live="1"></div>
  </main>
</BaseLayout>
