---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import {
  MODAL_EDGE_DESCRIPTION_LIVE,
  MODAL_EDGE_LEDE_LIVE,
} from '../../lib/modal-edge';
import '../../styles/modal-edge.css';
---

<BaseLayout title="Modal Edge · Live" description={MODAL_EDGE_DESCRIPTION_LIVE}>
  <main class="shell">
    <DemoHead
      variant="modal"
      mode="live"
      title="Modal Edge"
      lede={MODAL_EDGE_LEDE_LIVE}
    />
    <div id="modal-edge-root" data-live="1"></div>
  </main>
</BaseLayout>
