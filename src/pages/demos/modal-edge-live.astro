---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import ModalMode from '../../components/ModalMode.astro';
import { hrefWithBase } from '../../lib/base';
import '../../styles/modal-edge.css';
---

<BaseLayout
  title="Modal Edge · Live"
  description="Pointer near the edges peeks the modal sheet — constant reaction test."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Hub</a></p>
    <p class="eyebrow">Demo · Variant B · Modal Edge</p>
    <h1>Modal Edge · Live</h1>
    <p class="lede">
      Same stack reveal. Moving toward the top or left edge peeks the sheet without a click.
      Click still locks the full reveal.
    </p>
    <VariantSwitch current="modal" />
    <ModalMode current="live" />
    <div id="modal-edge-root"></div>
  </main>
</BaseLayout>

<script>
  import { mountModalEdge } from '../../components/vanilla/mountModalEdge';

  const root = document.getElementById('modal-edge-root');
  if (root) mountModalEdge({ root, live: true });
</script>
