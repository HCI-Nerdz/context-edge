---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import FrameworkSwitch from '../../components/FrameworkSwitch.astro';
import FrameworkMark from '../../components/FrameworkMark.astro';
import MapEdgeShell from '../../components/solid/MapEdgeShell';
import { hrefWithBase } from '../../lib/base';
---

<BaseLayout
  title="Solid cloud · Context Edge"
  description="Solid implementation demo — cloud-console parody rescued by a Context Edge."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Context Edge</a></p>
    <p class="eyebrow">Demo · Solid</p>
    <div class="page-kicker">
      <FrameworkMark id="solid" />
      <h1>Cloud console → rails</h1>
    </div>
    <p class="lede">
      Fine-grained signals drive hover/open/platform identity. Toggle header overload to feel the
      anti-pattern.
    </p>
    <div class="demo-switches">
      <VariantSwitch current="map" framework="solid" />
      <FrameworkSwitch current="solid" variant="map" />
    </div>
    <MapEdgeShell client:load showOverloadToggle={true} initialId="cloud" />
  </main>
</BaseLayout>
