---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import MapEdgeShell from '../../components/solid/MapEdgeShell';
---

<BaseLayout
  title="Solid cloud · Context Edge"
  description="Solid implementation demo — cloud-console parody rescued by a Context Edge."
>
  <main class="shell">
    <DemoHead
      variant="map"
      framework="solid"
      title="Cloud console → rails"
      lede="Fine-grained signals drive hover/open/platform identity. Toggle header overload to feel the anti-pattern."
    />
    <MapEdgeShell client:load showOverloadToggle={true} initialId="cloud" />
  </main>
</BaseLayout>
