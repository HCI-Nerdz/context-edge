---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Throggle from '../../components/Throggle.astro';
import ContextRailsShell from '../../components/solid/ContextRailsShell';
import { hrefWithBase } from '../../lib/base';
---

<BaseLayout
  title="Solid cloud · Context rails"
  description="Solid island demo — cloud-console parody rescued by context rails."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Hub</a></p>
    <p class="eyebrow">Demo · Solid</p>
    <h1>Cloud console → rails</h1>
    <p class="lede">
      Fine-grained signals drive hover/open/platform identity. Toggle header overload to feel the
      anti-pattern.
    </p>
    <Throggle current="map" />
    <ContextRailsShell client:load showOverloadToggle={true} initialId="cloud" />
  </main>
</BaseLayout>
