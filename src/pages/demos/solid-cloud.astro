---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import FrameworkMark from '../../components/FrameworkMark.astro';
import ContextRailsShell from '../../components/solid/ContextRailsShell';
import { hrefWithBase } from '../../lib/base';
---

<BaseLayout
  title="Solid cloud · Edge Bar"
  description="Solid island demo — cloud-console parody rescued by an Edge Bar."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Edge Bar</a></p>
    <p class="eyebrow">Demo · Solid</p>
    <div class="page-kicker">
      <FrameworkMark id="solid" />
      <h1>Cloud console → rails</h1>
    </div>
    <p class="lede">
      Fine-grained signals drive hover/open/platform identity. Toggle header overload to feel the
      anti-pattern.
    </p>
    <div class="demo-switches">
      <VariantSwitch current="map" />
    </div>
    <ContextRailsShell client:load showOverloadToggle={true} initialId="cloud" />
  </main>
</BaseLayout>
