---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import ModalEdgeShell from '../../components/react/ModalEdgeShell';
import '../../styles/modal-edge.css';
---

<BaseLayout
  title="React Modal Edge · Live · Context Edge"
  description="React implementation — Modal Edge with live edge peek."
>
  <main class="shell">
    <DemoHead
      variant="modal"
      mode="live"
      framework="react"
      title="Modal Edge"
      lede="Pointer near the edges peeks the sheet. Click to open the full stack."
    />
    <ModalEdgeShell client:load island="React" live={true} />
  </main>
</BaseLayout>
