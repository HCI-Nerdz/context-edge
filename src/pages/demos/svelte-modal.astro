---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import ModalEdgeShell from '../../components/svelte/ModalEdgeShell.svelte';
import '../../styles/modal-edge.css';
---

<BaseLayout
  title="Svelte Modal Edge · Context Edge"
  description="Svelte implementation — Modal Edge ancestry stack."
>
  <main class="shell">
    <DemoHead
      variant="modal"
      mode="rest"
      framework="svelte"
      title="Modal Edge"
      lede="Same L-join as Map. Click slides this sheet back; ancestors stay as colored layers."
    />
    <ModalEdgeShell client:load island="Svelte" />
  </main>
</BaseLayout>
