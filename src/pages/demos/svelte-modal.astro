---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import FrameworkSwitch from '../../components/FrameworkSwitch.astro';
import FrameworkMark from '../../components/FrameworkMark.astro';
import ModalEdgeShell from '../../components/svelte/ModalEdgeShell.svelte';
import { hrefWithBase } from '../../lib/base';
import '../../styles/modal-edge.css';
---

<BaseLayout
  title="Svelte Modal Edge · Context Edge"
  description="Svelte island — Modal Edge ancestry stack."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Context Edge</a></p>
    <p class="eyebrow">Demo · Svelte · Variant B</p>
    <div class="page-kicker">
      <FrameworkMark id="svelte" />
      <h1>Modal Edge</h1>
    </div>
    <p class="lede">
      Same L-join as Map. Click slides this sheet back; ancestors stay as colored layers.
    </p>
    <div class="demo-switches">
      <VariantSwitch current="modal" framework="svelte" />
      <FrameworkSwitch current="svelte" variant="modal" />
    </div>
    <ModalEdgeShell client:load island="Svelte" />
  </main>
</BaseLayout>
