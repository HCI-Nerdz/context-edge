---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
---

<BaseLayout
  title="Map Edge"
  description="Map Edge — hover expands the rails; click slides the page off a map underneath."
>
  <main class="shell">
    <DemoHead
      variant="map"
      title="Map Edge"
      lede="This animation reveals a navigation map underneath the current page. Much like a city with streets and buildings, what's at the bottom level allows travel between activities."
    />
    <div id="vanilla-root"></div>
  </main>
</BaseLayout>
