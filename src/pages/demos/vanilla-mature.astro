---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
---

<BaseLayout
  title="Map Edge"
  description="Map Edge — color-only rails that open a wireframe directory."
>
  <main class="shell">
    <DemoHead
      variant="map"
      mode="rest"
      title="Map Edge"
      lede="Click the L-edge for a wireframe directory. Streets under the activity, not tabs on the roof."
    />
    <div id="vanilla-root"></div>
  </main>
</BaseLayout>
