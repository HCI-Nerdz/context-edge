---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import PathEdgeShell from '../../components/react/PathEdgeShell';
import { PATH_EDGE_DESCRIPTION, PATH_EDGE_LEDE } from '../../lib/path-edge';
import '../../styles/path-edge.css';
---

<BaseLayout title="React Path Edge · Context Edge" description={PATH_EDGE_DESCRIPTION}>
  <main class="shell">
    <DemoHead
      variant="path"
      framework="react"
      title="Path Edge"
      lede={PATH_EDGE_LEDE}
    />
    <PathEdgeShell client:load />
  </main>
</BaseLayout>
