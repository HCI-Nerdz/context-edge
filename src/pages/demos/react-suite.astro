---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import MapEdgeShell from '../../components/react/MapEdgeShell';
---

<BaseLayout
  title="React suite · Context Edge"
  description="React implementation demo — suite shell with duo-tone platform overlays."
>
  <main class="shell">
    <DemoHead
      variant="map"
      framework="react"
      title="Suite shell"
      lede="Portable toward Next.js App Router as a client layout wrapper around page content."
    />
    <MapEdgeShell client:load initialId="gmail" />
  </main>
</BaseLayout>
