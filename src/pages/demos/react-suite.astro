---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import FrameworkMark from '../../components/FrameworkMark.astro';
import ContextRailsShell from '../../components/react/ContextRailsShell';
import { hrefWithBase } from '../../lib/base';
---

<BaseLayout
  title="React suite · Edge Bar"
  description="React island demo — suite shell with duo-tone platform overlays."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Edge Bar</a></p>
    <p class="eyebrow">Demo · React</p>
    <div class="page-kicker">
      <FrameworkMark id="react" />
      <h1>Suite shell</h1>
    </div>
    <p class="lede">
      Portable toward Next.js App Router as a client layout wrapper around page content.
    </p>
    <div class="demo-switches">
      <VariantSwitch current="map" />
    </div>
    <ContextRailsShell client:load initialId="gmail" />
  </main>
</BaseLayout>
