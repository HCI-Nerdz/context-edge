---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Throggle from '../../components/Throggle.astro';
import ContextRailsShell from '../../components/react/ContextRailsShell';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="React suite · Context rails"
  description="React island demo — suite shell with duo-tone platform overlays."
>
  <main class="shell">
    <p><a class="back" href={base}>← Hub</a></p>
    <p class="eyebrow">Demo · React</p>
    <h1>Suite shell</h1>
    <p class="lede">
      Portable toward Next.js App Router as a client layout wrapper around page content.
    </p>
    <Throggle current="map" />
    <ContextRailsShell client:load initialId="mail" />
  </main>
</BaseLayout>
