---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import FrameworkSwitch from '../../components/FrameworkSwitch.astro';
import FrameworkMark from '../../components/FrameworkMark.astro';
import PathEdgeShell from '../../components/svelte/PathEdgeShell.svelte';
import { hrefWithBase } from '../../lib/base';
import '../../styles/path-edge.css';
---

<BaseLayout
  title="Svelte Path Edge · Edge Bar"
  description="Svelte island — Path Edge breadcrumb colors."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Edge Bar</a></p>
    <p class="eyebrow">Demo · Svelte · Variant C</p>
    <div class="page-kicker">
      <FrameworkMark id="svelte" />
      <h1>Path Edge</h1>
    </div>
    <p class="lede">
      Same L-join as Map and Modal. The rails are the hops you took — unique colors, current at the corner.
    </p>
    <div class="demo-switches">
      <VariantSwitch current="path" framework="svelte" />
      <FrameworkSwitch current="svelte" variant="path" />
    </div>
    <PathEdgeShell client:load island="Svelte" />
  </main>
</BaseLayout>
