---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import PathMode from '../../components/PathMode.astro';
import { hrefWithBase } from '../../lib/base';
import '../../styles/path-edge.css';
---

<BaseLayout
  title="Path Edge · Tint · Live"
  description="Tint color hint plus constant dock reaction — fourth Path mode."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Hub</a></p>
    <p class="eyebrow">Demo · Variant C · Path Edge</p>
    <h1>Path Edge · Tint · Live</h1>
    <p class="lede">
      Same stepped fade and mouse color-hole as Tint, plus Live dock amplify while the
      pointer travels the rail. Compare with Live (full chroma) to see if constant motion
      is worse when the colors are already quiet.
    </p>
    <VariantSwitch current="path" />
    <PathMode current="tint-live" />
    <div id="path-edge-root"></div>
  </main>
</BaseLayout>

<script>
  import { mountPathWorkshop } from '../../components/vanilla/mountPathEdge';

  const root = document.getElementById('path-edge-root');
  if (root) mountPathWorkshop({ root, mode: 'tint-live' });
</script>
