---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import '../../styles/modal-edge.css';
---

<BaseLayout
  title="Modal Edge"
  description="Variant B: View Transitions slide the current sheet to reveal colored ancestor layers."
>
  <main class="shell">
    <DemoHead
      variant="modal"
      mode="rest"
      title="Modal Edge"
      lede="The edge is this sheet. Click to slide it back; ancestor layers stay underneath."
    />
    <div id="modal-edge-root" transition:animate="fade"></div>
  </main>
</BaseLayout>

<script data-astro-rerun>
  import { mountModalEdge } from '../../components/vanilla/mountModalEdge';

  const root = document.getElementById('modal-edge-root');
  if (root) {
    root.replaceChildren();
    mountModalEdge({ root });
  }
</script>
