---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import { hrefWithBase } from '../../lib/base';
---

<BaseLayout
  title="Modal Edge · Nav Edge stack"
  description="Variant B: View Transitions slide the current sheet to reveal colored ancestor layers."
>
  <main class="shell">
    <p><a class="back" href={hrefWithBase('')}>← Hub</a></p>
    <p class="eyebrow">Demo · Variant B · Modal Edge</p>
    <h1>Modal Edge (stack reveal)</h1>
    <p class="lede">
      Each page is a modal sheet on the path that produced it. The Nav Edge wears the
      <em>current</em> node’s color. Click the edge — the sheet slides down and right (View
      Transitions API) and ancestor layers show through. Click a layer to jump there.
    </p>
    <VariantSwitch current="modal" />
    <div id="modal-edge-root"></div>
  </main>
</BaseLayout>

<style is:global>
  .me-hint-btn {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.06);
    color: inherit;
    border-radius: 0.3rem;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    font-family: var(--font-display);
  }

  .me-viewport {
    --rail-idle: 0.35rem;
    --rail-hover: 2.75rem;
    position: relative;
    min-height: 28rem;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    overflow: hidden;
    background: #070a0c;
  }

  .me-stack {
    position: absolute;
    inset: 0.75rem 2.5rem 2.5rem 0.75rem;
    z-index: 1;
    pointer-events: none;
  }

  .me-viewport.is-revealed .me-stack {
    pointer-events: auto;
  }

  .me-layer {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 0.85rem 1fr;
    border: 0;
    padding: 0;
    margin: 0;
    text-align: left;
    color: inherit;
    cursor: pointer;
    border-radius: 0.35rem;
    overflow: hidden;
    transform: translate(
      calc(var(--depth) * 0.55rem),
      calc(var(--depth) * 0.55rem)
    );
    background:
      radial-gradient(100% 80% at 0% 0%, hsl(var(--layer-overlay) / 0.45), transparent 55%),
      linear-gradient(145deg, hsl(var(--layer-overlay) / 0.35), hsl(var(--layer-overlay-2) / 0.5));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    transition: filter 0.2s ease, transform 0.25s ease;
  }

  .me-layer:hover,
  .me-layer:focus-visible {
    filter: brightness(1.12);
    outline: 2px solid #fff;
    outline-offset: 2px;
    z-index: 2;
  }

  .me-layer-edge {
    background: hsl(var(--layer-overlay) / 0.95);
  }

  .me-layer-body {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    padding: 0.85rem 1rem;
    background: rgba(6, 10, 12, 0.35);
  }

  .me-layer-body strong {
    font-family: var(--font-display);
  }

  .me-layer-body small {
    opacity: 0.7;
  }

  .me-sheet {
    position: absolute;
    inset: 0;
    z-index: 3;
    background:
      radial-gradient(120% 90% at 10% 0%, hsl(var(--overlay) / 0.35), transparent 55%),
      linear-gradient(145deg, hsl(var(--overlay) / 0.22), hsl(var(--overlay-2) / 0.35) 55%, rgba(0, 0, 0, 0.4));
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
    transform-origin: top left;
  }

  .me-viewport.is-revealed .me-sheet {
    transform: translate(18%, 22%) scale(0.92);
    box-shadow: -12px -12px 40px rgba(0, 0, 0, 0.45);
    border-radius: 0.4rem;
    cursor: pointer;
  }

  .me-content {
    margin: calc(var(--rail-idle) + 0.85rem) 1rem 1rem calc(var(--rail-idle) + 0.85rem);
  }

  .me-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    font-size: 0.8rem;
    font-family: var(--font-display);
  }

  .me-crumb li {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(0, 0, 0, 0.25);
  }

  .me-crumb li:not(:last-child)::after {
    content: none;
  }

  /* View Transitions: slide sheet down+right when toggling reveal */
  ::view-transition-old(me-sheet),
  ::view-transition-new(me-sheet) {
    animation-duration: 0.45s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }

  ::view-transition-old(me-sheet) {
    animation-name: me-sheet-out;
  }

  ::view-transition-new(me-sheet) {
    animation-name: me-sheet-in;
  }

  @keyframes me-sheet-out {
    to {
      transform: translate(18%, 22%) scale(0.92);
      opacity: 0.92;
    }
  }

  @keyframes me-sheet-in {
    from {
      transform: translate(18%, 22%) scale(0.92);
      opacity: 0.92;
    }
  }
</style>

<script>
  import { mountModalEdge } from '../../components/vanilla/mountModalEdge';

  const root = document.getElementById('modal-edge-root');
  if (root) mountModalEdge({ root });
</script>
