---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHead from '../../components/DemoHead.astro';
import ModalEdgeShell from '../../components/solid/ModalEdgeShell';
import '../../styles/modal-edge.css';
---

<BaseLayout
  title="Solid Modal Edge · Context Edge"
  description="Solid implementation — Modal Edge ancestry stack."
>
  <main class="shell">
    <DemoHead
      variant="modal"
      mode="rest"
      framework="solid"
      title="Modal Edge"
      lede="Same L-join as Map. Click slides this sheet back; ancestors stay as colored layers."
    />
    <ModalEdgeShell client:load island="Solid" />
  </main>
</BaseLayout>
