---
import BaseLayout from '../layouts/BaseLayout.astro';
import VariantTile from '../components/VariantTile.astro';
import FrameworkMark from '../components/FrameworkMark.astro';
import { hrefWithBase } from '../lib/base';
import version from '../../version.json';
---

<BaseLayout
  title="Context Edge · HCI Nerdz"
  description="When suite headers stuff every product into one strip, you lose which world you are in. Context Edge puts that travel on thin edge rails — Map, Modal, and Path variants."
>
  <main class="shell">
    <p class="eyebrow">
      <a href="https://hci-nerdz.github.io/demos/context-edge/">HCI Nerdz</a>
      · MVP
    </p>
    <h1>Context Edge</h1>
    <p class="lede">
      You know the suite header that keeps growing — Mail, Drive, Admin, Cloud, Docs, all fighting for
      the same strip until you lose which product you are actually in. Context Edge keeps the page for
      the work you came to do, and puts cross-product travel on thin rails along the top and left edges
      of the shell.
    </p>
    <p class="lede">
      Three ways to play it here: a <strong>Map Edge</strong> that slides the page aside to reveal a
      directory already underneath; a <strong>Modal Edge</strong> that pushes this sheet back over
      colored ancestor layers; and a <strong>Path Edge</strong> whose rails hold the hops you took.
      Pick a tile below, or use the matrix for framework implementations.
    </p>
    <p class="meta-row">
      <a href="https://hci-nerdz.github.io/blog/ecosystem-nav-at-the-screen-edge/">Essay</a>
      <a href="https://hci-nerdz.github.io/docs/hci-nerdz/context-edge.html">Docs</a>
      <span>v{version.version}</span>
    </p>

    <nav class="variant-gallery" aria-label="Context Edge variants">
      <VariantTile
        id="map"
        label="Map Edge"
        href="demos/vanilla-mature/"
        blurb="The page slides off. The tree is already underneath."
      />
      <VariantTile
        id="modal"
        label="Modal Edge"
        href="demos/modal-edge/"
        blurb="This sheet slides back. Ancestors stay as layers."
      />
      <VariantTile
        id="path"
        label="Path Edge"
        href="demos/path-edge/"
        blurb="The edge contains the hops you took — unique colors."
      />
    </nav>

    <h2 class="hub-h2">Variants × implementations</h2>
    <p class="hub-note">
      Map and Modal share the L-join. Path Edge is a single edge (Top or Side). Solid, React, Svelte,
      and vanilla each host Map, Modal, and Path.
    </p>
    <div class="edge-matrix-wrap">
      <table class="edge-matrix">
        <thead>
          <tr>
            <th scope="col">Variant</th>
            <th scope="col">
              <span class="fw-head"><FrameworkMark id="vanilla" />Vanilla</span>
            </th>
            <th scope="col">
              <span class="fw-head"><FrameworkMark id="solid" />Solid</span>
            </th>
            <th scope="col">
              <span class="fw-head"><FrameworkMark id="react" />React</span>
            </th>
            <th scope="col">
              <span class="fw-head"><FrameworkMark id="svelte" />Svelte</span>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Map Edge</th>
            <td>
              <a class="matrix-cell" href={hrefWithBase('demos/vanilla-mature/')}>
                <span class="variant-preview variant-preview-map" aria-hidden="true"></span>
                Vanilla
              </a>
            </td>
            <td>
              <a class="matrix-cell" href={hrefWithBase('demos/solid-cloud/')}>
                <span class="variant-preview variant-preview-map" aria-hidden="true"></span>
                Cloud
              </a>
            </td>
            <td>
              <a class="matrix-cell" href={hrefWithBase('demos/react-suite/')}>
                <span class="variant-preview variant-preview-map" aria-hidden="true"></span>
                Suite
              </a>
            </td>
            <td>
              <a class="matrix-cell" href={hrefWithBase('demos/svelte-community/')}>
                <span class="variant-preview variant-preview-map" aria-hidden="true"></span>
                Community
              </a>
            </td>
          </tr>
          <tr>
            <th scope="row">Modal Edge</th>
            <td>
              <div class="matrix-stack">
                <a class="matrix-cell" href={hrefWithBase('demos/modal-edge-live/')}>
                  <span class="variant-preview variant-preview-modal" aria-hidden="true">
                    <span class="variant-modal-mock"><i></i><i></i><i></i></span>
                  </span>
                  Live
                </a>
                <a class="matrix-cell" href={hrefWithBase('demos/modal-edge/')}>
                  <span class="variant-preview variant-preview-modal" aria-hidden="true">
                    <span class="variant-modal-mock"><i></i><i></i><i></i></span>
                  </span>
                  Still
                </a>
              </div>
            </td>
            <td>
              <div class="matrix-stack">
                <a class="matrix-cell" href={hrefWithBase('demos/solid-modal-live/')}>
                  <span class="variant-preview variant-preview-modal" aria-hidden="true">
                    <span class="variant-modal-mock"><i></i><i></i><i></i></span>
                  </span>
                  Live
                </a>
                <a class="matrix-cell" href={hrefWithBase('demos/solid-modal/')}>
                  <span class="variant-preview variant-preview-modal" aria-hidden="true">
                    <span class="variant-modal-mock"><i></i><i></i><i></i></span>
                  </span>
                  Still
                </a>
              </div>
            </td>
            <td>
              <div class="matrix-stack">
                <a class="matrix-cell" href={hrefWithBase('demos/react-modal-live/')}>
                  <span class="variant-preview variant-preview-modal" aria-hidden="true">
                    <span class="variant-modal-mock"><i></i><i></i><i></i></span>
                  </span>
                  Live
                </a>
                <a class="matrix-cell" href={hrefWithBase('demos/react-modal/')}>
                  <span class="variant-preview variant-preview-modal" aria-hidden="true">
                    <span class="variant-modal-mock"><i></i><i></i><i></i></span>
                  </span>
                  Still
                </a>
              </div>
            </td>
            <td>
              <div class="matrix-stack">
                <a class="matrix-cell" href={hrefWithBase('demos/svelte-modal-live/')}>
                  <span class="variant-preview variant-preview-modal" aria-hidden="true">
                    <span class="variant-modal-mock"><i></i><i></i><i></i></span>
                  </span>
                  Live
                </a>
                <a class="matrix-cell" href={hrefWithBase('demos/svelte-modal/')}>
                  <span class="variant-preview variant-preview-modal" aria-hidden="true">
                    <span class="variant-modal-mock"><i></i><i></i><i></i></span>
                  </span>
                  Still
                </a>
              </div>
            </td>
          </tr>
          <tr>
            <th scope="row">Path Edge</th>
            <td>
              <a class="matrix-cell" href={hrefWithBase('demos/path-edge/')}>
                <span class="variant-preview variant-preview-path" aria-hidden="true"></span>
                Workshop
              </a>
            </td>
            <td>
              <a class="matrix-cell" href={hrefWithBase('demos/solid-path/')}>
                <span class="variant-preview variant-preview-path" aria-hidden="true"></span>
                Solid
              </a>
            </td>
            <td>
              <a class="matrix-cell" href={hrefWithBase('demos/react-path/')}>
                <span class="variant-preview variant-preview-path" aria-hidden="true"></span>
                React
              </a>
            </td>
            <td>
              <a class="matrix-cell" href={hrefWithBase('demos/svelte-path/')}>
                <span class="variant-preview variant-preview-path" aria-hidden="true"></span>
                Svelte
              </a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="hub-h2">Framework impedance match (short)</h2>
    <ul class="hub-list">
      <li>
        <strong>Solid / SolidStart</strong> — long-lived shell state; drop the Solid implementation into a
        SolidStart layout.
      </li>
      <li>
        <strong>React / Next.js</strong> — same shell as a <code>"use client"</code> layout wrapper.
      </li>
      <li>
        <strong>Svelte / SvelteKit</strong> — strong for edge motion; Kit layouts mirror the substrate.
      </li>
      <li>
        <strong>Astro implementations</strong> — this demo desk. Production SPAs should own the bar inside
        their shell.
      </li>
    </ul>
  </main>
</BaseLayout>
