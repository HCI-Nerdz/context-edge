---
interface Props {
  id: 'solid' | 'react' | 'svelte' | 'vanilla';
  label?: boolean;
}

const { id, label = false } = Astro.props;
const names = { solid: 'Solid', react: 'React', svelte: 'Svelte', vanilla: 'Vanilla' };
---

<span class:list={['fw-mark', `fw-${id}`]}>
  {
    id === 'react' && (
      <svg viewBox="-11.5 -10.23 23 20.46" aria-hidden="true">
        <circle r="2.05" fill="currentColor"></circle>
        <g fill="none" stroke="currentColor" stroke-width="1">
          <ellipse rx="11" ry="4.2"></ellipse>
          <ellipse rx="11" ry="4.2" transform="rotate(60)"></ellipse>
          <ellipse rx="11" ry="4.2" transform="rotate(120)"></ellipse>
        </g>
      </svg>
    )
  }
  {
    id === 'solid' && (
      <svg viewBox="0 0 166 155.3" aria-hidden="true">
        <path
          fill="var(--fw-a)"
          d="M163 35S110-4 69 5l-3 1c-6 2-11 5-14 9l-2 3-15 26 26 5c11 7 25 10 38 7l46 9 18-30z"
        ></path>
        <path
          fill="var(--fw-b)"
          d="M163 35S110-4 69 5l-3 1c31 0 55 22 55 22l-9 15c-3 2-5 6-6 9l-2 3-13 22s46 4 65-30l1-1-1-11z"
        ></path>
        <path
          fill="var(--fw-c)"
          d="M9.7 86.9 35 92c12 7 26 10 38 7l46 9-15 26-3 1c-42 9-93-30-93-30l1-11 0-7z"
        ></path>
        <path
          fill="var(--fw-a)"
          d="m65 80-15 26-3 1c-31 0-55-22-55-22l9-15c3-2 5-6 6-9l2-3 13-22s-46-4-65 30l-1 1 1 11 46-9c12 7 26 10 38 7z"
        ></path>
      </svg>
    )
  }
  {
    id === 'svelte' && (
      <svg viewBox="0 0 32 39" aria-hidden="true">
        <path
          fill="currentColor"
          d="M28.2 4.4C25.2.6 20 .2 15.8 2.6L6.3 8.2c-2.4 1.4-4 3.8-4.3 6.5-.3 2.3.3 4.6 1.7 6.4-.9 1.4-1.4 3-1.3 4.6.3 2.8 1.9 5.2 4.3 6.5l9.5 5.6c1.3.8 2.8 1.2 4.2 1.2 3 0 5.9-1.6 7.5-4.3l3.4-5.8c1.4-2.4 1.6-5.3.5-7.8 1.1-1.5 1.7-3.3 1.6-5.1-.3-2.8-1.9-5.2-4.3-6.6L28.2 4.4zm-3.7 21.6-3.4 5.8c-1.1 1.9-3.6 2.6-5.6 1.4l-9.5-5.6c-1.1-.6-1.8-1.8-1.9-3.1-.1-1.3.4-2.5 1.4-3.3l9.5-5.6c.6-.4 1.3-.5 2-.5 1.4 0 2.8.8 3.6 2l3.4 5.8c.6 1.1.8 2.4.4 3.6-.3 1.1-1 2.1-2 2.5zm.6-13.2-1.7 1c-.3-.5-.7-1-1.2-1.4l-3.4-5.8c-.8-1.3-2.1-2-3.5-2-.6 0-1.3.2-1.9.5L4.5 10.5C3.4 11.1 2.7 12.2 2.6 13.4c-.1 1.3.4 2.5 1.4 3.3l.4.2 1.7-1c.3.5.7 1 1.2 1.4l3.4 5.8c.8 1.3 2.1 2 3.6 2 .6 0 1.3-.2 1.9-.5l9.5-5.6c1.1-.6 1.8-1.8 1.9-3.1.1-1.2-.4-2.5-1.4-3.3l-.4-.2z"
        ></path>
      </svg>
    )
  }
  {
    id === 'vanilla' && (
      <svg viewBox="0 0 256 256" aria-hidden="true">
        <rect width="256" height="256" rx="28" fill="#f7df1e"></rect>
        <path
          fill="#111"
          d="M67 216.5 98.7 198c2 3.6 3.8 6.6 8.2 6.6 4.2 0 6.9-1.6 6.9-8.1V127h39v70c0 27.2-16 39.6-39.4 39.6-21.1 0-33.3-10.9-39.4-24.2zm90.8-2.2 31.6-18.2c4.2 6.8 9.6 11.8 19.1 11.8 8 0 13.1-4 13.1-9.5 0-6.6-5.2-9-14-13.2l-4.8-2.1c-13.9-5.9-23.1-13.3-23.1-29 0-14.4 11-25.4 28.1-25.4 12.2 0 21 4.2 27.3 15.3l-29.8 19.1c-2-3.6-5.3-5-9.5-5-4.3 0-7.1 2.7-7.1 6.6 0 4.6 2.8 6.5 9.3 9.3l4.8 2.1c16.4 7 25.6 14.1 25.6 30.1 0 17.2-13.5 26.7-31.7 26.7-17.8 0-29.3-8.5-34.9-19.6z"
        ></path>
      </svg>
    )
  }
  {label && <span class="fw-name">{names[id]}</span>}
</span>
