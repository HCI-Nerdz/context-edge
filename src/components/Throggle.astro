---
interface Props {
  current: 'map' | 'modal' | 'path';
}

const { current } = Astro.props;
const base = import.meta.env.BASE_URL;

const items = [
  { id: 'map' as const, label: 'Map', href: `${base}demos/vanilla-mature/` },
  { id: 'modal' as const, label: 'Modal', href: `${base}demos/modal-edge/` },
  { id: 'path' as const, label: 'Path', href: `${base}demos/path-edge/` },
];
---

<nav class="throggle" aria-label="Nav Edge variants">
  <span class="throggle-name">Throggle</span>
  <div class="throggle-track" role="list">
    {
      items.map((item) =>
        item.id === current ? (
          <span class="throggle-item is-current" role="listitem" aria-current="page">
            {item.label}
          </span>
        ) : (
          <a class="throggle-item" role="listitem" href={item.href}>
            {item.label}
          </a>
        ),
      )
    }
  </div>
</nav>
