---
import { hrefWithBase } from '../lib/base';
import { modalRoute, type FrameworkId, type ModalModeId } from '../lib/demo-routes';

interface Props {
  current: ModalModeId;
  framework?: FrameworkId;
}

const { current, framework = 'vanilla' } = Astro.props;
const items = [
  { id: 'live' as const, label: 'Live', href: hrefWithBase(modalRoute(framework, 'live')) },
  { id: 'rest' as const, label: 'Still', href: hrefWithBase(modalRoute(framework, 'rest')) },
];
---

<nav class="variant-switch" aria-label="Modal Edge mode">
  <span class="variant-switch-name">Mode</span>
  <div class="variant-switch-track" role="list">
    {
      items.map((item) => (
        <a
          class:list={['variant-switch-item', { 'is-current': item.id === current }]}
          role="listitem"
          href={item.href}
          aria-current={item.id === current ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </div>
</nav>
