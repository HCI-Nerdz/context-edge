---
import VariantSwitch from './VariantSwitch.astro';
import FrameworkSwitch from './FrameworkSwitch.astro';
import ModalMode from './ModalMode.astro';
import FrameworkMark from './FrameworkMark.astro';
import { hrefWithBase } from '../lib/base';

interface Props {
  variant: 'map' | 'modal' | 'path';
  mode?: 'rest' | 'live';
  title: string;
  lede: string;
}

const { variant, mode, title, lede } = Astro.props;
const letter = variant === 'map' ? 'A' : variant === 'modal' ? 'B' : 'C';
const modalMode = mode ?? 'rest';
---

<div class="demo-head" transition:name="demo-head">
  <p><a class="back" href={hrefWithBase('')}>← Context Edge</a></p>
  <p class="eyebrow">Demo · Variant {letter}</p>
  <div class="page-kicker">
    <FrameworkMark id="vanilla" />
    <h1>{title}</h1>
  </div>
  <p class="lede">{lede}</p>
  <div class="demo-switches">
    <VariantSwitch current={variant} framework="vanilla" />
    <FrameworkSwitch current="vanilla" variant={variant} mode={variant === 'modal' ? modalMode : undefined} />
    {variant === 'modal' && mode && <ModalMode current={mode} framework="vanilla" />}
  </div>
</div>
