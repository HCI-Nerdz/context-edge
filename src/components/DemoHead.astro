---
import VariantSwitch from './VariantSwitch.astro';
import FrameworkSwitch from './FrameworkSwitch.astro';
import ModalMode from './ModalMode.astro';
import FrameworkMark from './FrameworkMark.astro';
import { hrefWithBase } from '../lib/base';
import type { FrameworkId } from '../lib/demo-routes';
import { frameworks } from '../lib/demo-routes';

interface Props {
  variant: 'map' | 'modal' | 'path';
  mode?: 'rest' | 'live';
  framework?: FrameworkId;
  /** Active variant label shown after the selector (e.g. Path Edge). */
  title: string;
  lede: string;
}

const { variant, mode, framework = 'vanilla', title, lede } = Astro.props;
const letter = variant === 'map' ? 'A' : variant === 'modal' ? 'B' : 'C';
const modalMode = mode ?? 'rest';
const fwLabel = frameworks.find((f) => f.id === framework)?.label ?? 'Vanilla';
const parts = [
  'Demo',
  framework === 'vanilla' ? null : fwLabel,
  `Variant ${letter}`,
  mode === 'live' ? 'Live' : null,
].filter(Boolean);
const eyebrow = parts.join(' · ');
---

<div class="demo-head" transition:name="demo-head">
  <p class="demo-back">
    <a class="back" href={hrefWithBase('')}>← All variants</a>
  </p>
  <p class="eyebrow">{eyebrow}</p>
  <div class="page-kicker">
    <FrameworkMark id={framework} />
    <h1>Context Edge</h1>
  </div>
  <div class="demo-switches">
    <VariantSwitch current={variant} framework={framework} />
    <FrameworkSwitch current={framework} variant={variant} mode={variant === 'modal' ? modalMode : undefined} />
    {variant === 'modal' && mode && <ModalMode current={mode} framework={framework} />}
  </div>
  <div class="variant-blurb">
    <h2 class="variant-title">{title}</h2>
    <p class="lede">{lede}</p>
  </div>
</div>
