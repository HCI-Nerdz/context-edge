---
import { hrefWithBase } from '../lib/base';
import { variantRoutes, type FrameworkId, type VariantId } from '../lib/demo-routes';

interface Props {
  current: VariantId;
  framework?: FrameworkId;
}

const { current, framework = 'vanilla' } = Astro.props;

const items = [
  { id: 'map' as const, label: 'Map' },
  { id: 'modal' as const, label: 'Modal' },
  { id: 'path' as const, label: 'Path' },
];
---

<nav class="variant-switch variant-switch-previews" aria-label="Variant" transition:name="variant-switch">
  <span class="variant-switch-name">Variant</span>
  <div class="variant-switch-track variant-switch-thumbs" role="list">
    {
      items.map((item) => (
        <a
          class:list={['variant-thumb', { 'is-current': item.id === current }]}
          role="listitem"
          href={hrefWithBase(variantRoutes[framework][item.id])}
          aria-current={item.id === current ? 'page' : undefined}
        >
          <span class:list={['variant-preview', `variant-preview-${item.id}`]} aria-hidden="true">
            {item.id === 'modal' && (
              <span class="variant-modal-mock">
                <i></i>
                <i></i>
                <i></i>
              </span>
            )}
          </span>
          <span class="variant-thumb-label">{item.label}</span>
        </a>
      ))
    }
  </div>
</nav>
