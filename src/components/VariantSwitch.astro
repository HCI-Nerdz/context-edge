---
import { hrefWithBase } from '../lib/base';

interface Props {
  current: 'map' | 'modal' | 'path';
}

const { current } = Astro.props;

const items = [
  { id: 'map' as const, label: 'Map', href: hrefWithBase('demos/vanilla-mature/') },
  { id: 'modal' as const, label: 'Modal', href: hrefWithBase('demos/modal-edge/') },
  { id: 'path' as const, label: 'Path', href: hrefWithBase('demos/path-edge/') },
];
---

<nav class="variant-switch" aria-label="Variant">
  <span class="variant-switch-name">Variant</span>
  <div class="variant-switch-track" role="list">
    {
      items.map((item) => (
        <a
          class:list={['variant-switch-item', { 'is-current': item.id === current }]}
          role="listitem"
          href={item.href}
          aria-current={item.id === current ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </div>
</nav>
