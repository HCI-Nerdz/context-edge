---
import { hrefWithBase } from '../lib/base';

interface Props {
  current: 'rest' | 'live';
}

const { current } = Astro.props;
const items = [
  { id: 'rest' as const, label: 'Rest', href: hrefWithBase('demos/vanilla-mature/') },
  { id: 'live' as const, label: 'Live', href: hrefWithBase('demos/map-edge-live/') },
];
---

<nav class="variant-switch" aria-label="Map Edge mode">
  <span class="variant-switch-name">Mode</span>
  <div class="variant-switch-track" role="list">
    {
      items.map((item) => (
        <a
          class:list={['variant-switch-item', { 'is-current': item.id === current }]}
          role="listitem"
          href={item.href}
          aria-current={item.id === current ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </div>
</nav>
